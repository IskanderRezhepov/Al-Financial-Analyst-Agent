# Default: local Ollama; no API key required. Run `ollama list` first.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:4b-instruct
# Original tutorial route: set LLM_PROVIDER=thesys and supply your own key.
# The tutorial passes the Thesys key using OPENAI_API_KEY, despite its name.
OPENAI_API_KEY=
THESYS_BASE_URL=https://api.thesys.dev/v1/embed/
THESYS_MODEL=c1/openai/gpt-5/v-20250930
LLM_TIMEOUT_SECONDS=240

